# Preserve the exact byte representation committed for every file.
# In particular, do not normalize CRLF or LF during checkout, reset, add, or commit.
* -text

# Keep source files text-diffable without line-ending conversion.
*.c      -text diff
*.cc     -text diff
*.cpp    -text diff
*.cxx    -text diff
*.h      -text diff
*.hh     -text diff
*.hpp    -text diff
*.hxx    -text diff
*.inc    -text diff
*.inl    -text diff

# Assembly and linker source files.
*.s      -text diff
*.S      -text diff
*.asm    -text diff
*.ld     -text diff
*.lds    -text diff

# Build files and code-generation scripts.
Makefile       -text diff
makefile       -text diff
CMakeLists.txt -text diff
*.mk           -text diff
*.cmake        -text diff
*.py           -text diff
*.sh           -text diff
*.bash         -text diff
*.zsh          -text diff
*.ps1          -text diff

# Eclipse and development project metadata.
.project           -text diff
.cproject          -text diff
.settings/*.prefs  -text diff
*.launch           -text diff
.vscode/*.json     -text diff
.github/*.yml      -text diff
.github/*.yaml     -text diff
.github/**/*.yml   -text diff
.github/**/*.yaml  -text diff

# Repository control and documentation files.
.gitattributes -text diff
.gitignore     -text diff
*.md           -text diff
*.txt          -text diff
*.rst          -text diff
README*        -text diff
LICENSE*       -text diff
NOTICE*        -text diff
COPYING*       -text diff
docs/**        -text diff

# Third-party source keeps the upstream byte representation.
external/**  -text diff
fatfs/**     -text diff
littlefs/**  -text diff
micro-ecc/** -text diff

# Binary files must never undergo line-ending conversion or textual merging.
*.a      binary
*.bin    binary
*.bmp    binary
*.dll    binary
*.dylib  binary
*.elf    binary
*.gif    binary
*.ico    binary
*.jpeg   binary
*.jpg    binary
*.lib    binary
*.o      binary
*.pdf    binary
*.png    binary
*.so     binary
*.woff   binary
*.woff2  binary
*.zip    binary

# IOsonata uses .h for its C++ classes and implementation interfaces.
*.h linguist-language=C++

# Explicit C sources remain C.
*.c linguist-language=C

# Third-party code does not represent the IOsonata implementation.
external/**  linguist-vendored
fatfs/**     linguist-vendored
littlefs/**  linguist-vendored
micro-ecc/** linguist-vendored
