# Keep normal Git text detection. Unlisted text files, including documentation,
# remain text but do not have a repository-enforced checkout line ending.
* text=auto

# C and C++ source files.
*.c      text eol=lf
*.cc     text eol=lf
*.cpp    text eol=lf
*.cxx    text eol=lf
*.h      text eol=lf
*.hh     text eol=lf
*.hpp    text eol=lf
*.hxx    text eol=lf
*.inc    text eol=lf
*.inl    text eol=lf

# Assembly and linker source files.
*.s      text eol=lf
*.S      text eol=lf
*.asm    text eol=lf
*.ld     text eol=lf
*.lds    text eol=lf

# Build files and code-generation scripts.
Makefile       text eol=lf
makefile       text eol=lf
CMakeLists.txt text eol=lf
*.mk           text eol=lf
*.cmake        text eol=lf
*.py           text eol=lf
*.sh           text eol=lf
*.bash         text eol=lf
*.zsh          text eol=lf
*.ps1          text eol=lf

# Eclipse and development project metadata used to build the code.
.project           text eol=lf
.cproject          text eol=lf
.settings/*.prefs  text eol=lf
*.launch           text eol=lf
.vscode/*.json     text eol=lf
.github/*.yml      text eol=lf
.github/*.yaml     text eol=lf
.github/**/*.yml   text eol=lf
.github/**/*.yaml  text eol=lf

# Repository control files.
.gitattributes text eol=lf
.gitignore     text eol=lf

# Documentation remains ordinary text without a forced checkout EOL.
*.md   text
*.txt  text
*.rst  text

# Binary files must never undergo line-ending conversion.
*.a      binary
*.bin    binary
*.bmp    binary
*.dll    binary
*.dylib  binary
*.elf    binary
*.gif    binary
*.ico    binary
*.jpeg   binary
*.jpg    binary
*.lib    binary
*.o      binary
*.pdf    binary
*.png    binary
*.so     binary
*.woff   binary
*.woff2  binary
*.zip    binary

# IOsonata uses .h for its C++ classes and implementation interfaces.
*.h linguist-language=C++

# Explicit C sources remain C.
*.c linguist-language=C

# Add actual C-only header directories here.
# src/c_component/** linguist-language=C

# Third-party code does not represent the IOsonata implementation.
external/**  linguist-vendored
fatfs/**     linguist-vendored
littlefs/**  linguist-vendored
micro-ecc/** linguist-vendored
